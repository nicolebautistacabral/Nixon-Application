      "id": "2293c8e2-fe84",
      "name": "Capture Message",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        440,
        200
      ],
      "credentials": {
        "postgres": {
          "id": "REPLACE_POSTGRES_CRED",
          "name": "Nixon Supabase"
        }
      }
