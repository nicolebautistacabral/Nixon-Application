              "id": "is-task",
              "leftValue": "={{ $json.intent }}",
              "rightValue": "task",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "af61d072-86f6",
      "name": "Is It A Task?",
