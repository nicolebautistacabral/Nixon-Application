    {
      "parameters": {
        "jsCode": "// Batch 1 classifier: deterministic only. The Claude-backed classifier arrives\n// with the agents in batch 4. Keeping it rule-based here means the spine can be\n// tested end to end without an Anthropic credential.\nconst text = ($json.message?.text || '').trim();\nconst lower = text.toLowerCase();\nconst AGENTS = {\n  helix:   ['lab','plate','wp1','wp2','wp3','thesis','logbook','hematocrit','ic50','malaria','dd2','3d7'],\n  ember:   ['poem','manuscript','competition','chantpaint','neurogenicole','caption','post'],\n  compass: ['student','lesson','evaluation','qarint','tutor','campaign','marketing','zoho'],\n  ledger:  ['gumroad','product','revenue','sale','pricing','launch'],\n  cadence: ['portuguese','quiz','vocab','lesson pt','portugues'],\n  forge:   ['script','deploy','automation','workflow','api','tool'],\n};\nlet agent = 'nixon', best = 0;\nfor (const [slug, words] of Object.entries(AGENTS)) {\n  const hits = words.filter(w => lower.includes(w)).length;\n  if (hits > best) { best = hits; agent = slug; }\n}\nconst isCommand = text.startsWith('/');\nconst command = isCommand ? lower.split(/[\\s@]/)[0] : null;\n// A task is an imperative request. Questions and acknowledgements are not.\nconst VERBS = ['draft','write','find','get','log','check','make','build','send',\n               'prepare','review','search','update','add','create','plan'];\nconst looksLikeTask = !isCommand && text.length > 8 &&\n  (VERBS.some(v => lower.startsWith(v) || lower.includes(' ' + v + ' ')) ) &&\n  !text.endsWith('?');\nreturn [{ json: {\n  body: text, agent, command, isCommand,\n  intent: isCommand ? 'command' : (looksLikeTask ? 'task' : 'note'),\n  title: text.length > 90 ? text.slice(0, 87) + '\\u2026' : text,\n}}];"
      },
      "id": "bd433fbe-7e73",
      "name": "Classify",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        200
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
