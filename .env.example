# Copy to .env and fill in. .env is gitignored — never commit it.

# --- Postgres -----------------------------------------------------------
POSTGRES_USER=nixon
POSTGRES_PASSWORD=            # generate: openssl rand -base64 24

# --- n8n ----------------------------------------------------------------
# BACK THIS UP OFFLINE. Losing it makes every stored credential
# permanently unrecoverable.
N8N_ENCRYPTION_KEY=           # generate: openssl rand -base64 32

# Local dev: http://localhost:5678
# If exposing webhooks via a tunnel, put the public https URL here.
WEBHOOK_URL=http://localhost:5678

# --- Credentials below are entered in the n8n UI, not here --------------
# n8n stores them encrypted with N8N_ENCRYPTION_KEY. Listed so you know
# what to have ready before Phase 1:
#
#   Telegram Bot API      token from @BotFather
#   Google Calendar       OAuth2 — scoped to the "Nixon" sub-calendar
#   Google Sheets         OAuth2
#   Google Docs / Drive   OAuth2
#   Anthropic             API key, for the AI Agent nodes
#   Gumroad, Zoho, Base44 later phases
#
# --- Values the workflows need, set as n8n variables --------------------
# NIXON_TELEGRAM_CHAT_ID     your chat id — the allowlist. Anyone else is rejected.
# NIXON_CALENDAR_ID          the dedicated Nixon sub-calendar id
# NIXON_BOARD_SHEET_ID       the Google Sheet used as the readable board
