# Nixon — local reference only. Real values live in `supabase secrets set`.
# Copy to .env and fill in. .env is gitignored — never commit it.

# --- Supabase (from supabase.com → Project Settings → API) ---------------
SUPABASE_PROJECT_REF=
SUPABASE_URL=                      # https://<ref>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Telegram (@BotFather → /newbot) --------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=           # generate: openssl rand -hex 16

# --- Gemini (aistudio.google.com/apikey) ----------------------------------
GEMINI_API_KEY=

# --- Pulse cron auth --------------------------------------------------------
NIXON_CRON_SECRET=                 # generate: openssl rand -hex 16

# --- Google (Phase 5) -------------------------------------------------------
GOOGLE_SA_JSON=                    # base64 of the service-account key.json
GOOGLE_CALENDAR_ID=                # your gmail address
